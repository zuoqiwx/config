# Ghostty 1.3.1 — Neovim / TUI-focused

# --- Appearance ---
theme = TokyoNight Storm
font-family = JetBrainsMono Nerd Font Propo
font-size = 14
font-thicken = true
background-opacity = 1

# --- Neovim / TUI fidelity ---
clipboard-read = allow
clipboard-write = allow
shell-integration = detect
shell-integration-features = cursor,title,path
mouse-scroll-multiplier = precision:1,discrete:3
macos-option-as-alt = true

# Let Alt+Left/Right reach tmux as M-Left/M-Right so prefix+Alt+Left/Right
# resizes panes horizontally. Ghostty's defaults remap these to ESC b / ESC f
# (readline word-jump), which tmux never sees as M-Left/M-Right. Word-jump is
# restored in ~/.zshrc via bindkey on the CSI 1;3 sequences Ghostty now sends.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# --- Window / UX ---
# macos-titlebar-style = hidden
copy-on-select = clipboard
scrollback-limit = 10000000
confirm-close-surface = false
